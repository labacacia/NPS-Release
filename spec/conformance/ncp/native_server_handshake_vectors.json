        "emit_error": false
      }
    },
    {
      "id": "ncp.native_server.011",
      "description": "A decoded Hello with no version overlap receives the existing version error and closes.",
      "kind": "negative",
      "input": {
        "server": {
          "min_version": "0.8",
          "nps_version": "0.10",
          "supported_encodings": ["msgpack", "json"],
          "supported_protocols": ["ncp"],
          "max_frame_payload": 65535,
          "ext_support": false,
          "max_concurrent_streams": 32,
          "max_hello_payload": 65535,
          "preamble_timeout_ms": 10000,
          "hello_timeout_ms": 5000
        },
        "transport": {
          "preamble_hex": "4e50532f312e300a",
          "preamble_elapsed_ms": 2,
          "first_frame_type": "0x06",
          "first_frame_tier": "json",
          "first_frame_encrypted": false,
          "first_frame_extended": false,
          "hello_payload_length": 200,
          "hello_elapsed_ms": 3
        },
        "hello": {
          "min_version": "0.11",
          "nps_version": "0.12",
          "supported_encodings": ["msgpack"],
          "supported_protocols": ["ncp"],
          "max_frame_payload": 65535,
          "ext_support": false,
          "max_concurrent_streams": 32
        }
      },
      "expected": {
        "action": "error_close",
        "emit_error": true,
        "status": "NPS-PROTO-VERSION-INCOMPATIBLE",
        "error": "NCP-VERSION-INCOMPATIBLE"
      }
    },
    {
      "id": "ncp.native_server.012",
